{
  "application_name": "tuttitrip-worker",
  "contract_version": 1,
  "events": {
    "progress": {
      "properties": {
        "percent": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "stage",
        "percent"
      ],
      "type": "object"
    }
  },
  "queues": [
    "default",
    "local_llm",
    "openrouter"
  ],
  "workflows": {
    "embed_texts": {
      "input": {
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "source_id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "source_kind": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "texts": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "source_kind",
          "source_id",
          "texts"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "dimensions": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "stored": {
            "type": "integer"
          }
        },
        "required": [
          "model",
          "dimensions",
          "stored"
        ],
        "type": "object"
      },
      "queue": "default"
    },
    "extract_offer_evidence": {
      "input": {
        "$defs": {
          "RequirementLabel": {
            "properties": {
              "key": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "label": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "key",
              "label"
            ],
            "type": "object"
          }
        },
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "document_id": {
            "format": "uuid",
            "type": "string"
          },
          "provider": {
            "default": "openrouter",
            "enum": [
              "openrouter",
              "local"
            ],
            "type": "string"
          },
          "requirement_keys": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          },
          "requirements": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/RequirementLabel"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "trip_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "trip_id",
          "document_id",
          "requirement_keys"
        ],
        "type": "object"
      },
      "output": {
        "$defs": {
          "EvidenceQuote": {
            "properties": {
              "confidence": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "text": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              "verdict": {
                "anyOf": [
                  {
                    "enum": [
                      "present",
                      "absent",
                      "not_applicable"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "text"
            ],
            "type": "object"
          },
          "RequirementEvidence": {
            "properties": {
              "quotes": {
                "items": {
                  "$ref": "#/$defs/EvidenceQuote"
                },
                "maxItems": 10,
                "type": "array"
              },
              "requirement_key": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "requirement_key"
            ],
            "type": "object"
          }
        },
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/RequirementEvidence"
            },
            "maxItems": 50,
            "type": "array"
          }
        },
        "required": [
          "evidence"
        ],
        "type": "object"
      },
      "queue": "openrouter"
    },
    "fetch_place_candidates": {
      "input": {
        "properties": {
          "city_query": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "city_slug": {
            "anyOf": [
              {
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "contract_version": {
            "default": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "output": {
        "properties": {
          "city_slug": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "refreshed": {
            "type": "boolean"
          },
          "source": {
            "const": "osm",
            "default": "osm",
            "type": "string"
          },
          "stored": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "city_slug",
          "refreshed",
          "stored"
        ],
        "type": "object"
      },
      "queue": "default"
    },
    "generate_trip_plan": {
      "input": {
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "provider": {
            "default": "openrouter",
            "enum": [
              "openrouter",
              "local"
            ],
            "type": "string"
          },
          "request": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "trip_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "trip_id",
          "request"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "days": {
            "type": "integer"
          },
          "destination": {
            "type": "string"
          },
          "highlights": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "destination",
          "days",
          "highlights"
        ],
        "type": "object"
      },
      "queue": "openrouter"
    },
    "parse_pasted_plan": {
      "input": {
        "properties": {
          "city_slug": {
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "document_id": {
            "format": "uuid",
            "type": "string"
          },
          "provider": {
            "default": "openrouter",
            "enum": [
              "openrouter",
              "local"
            ],
            "type": "string"
          },
          "trip_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "trip_id",
          "document_id",
          "city_slug"
        ],
        "type": "object"
      },
      "output": {
        "$defs": {
          "MatchCandidate": {
            "properties": {
              "address": {
                "anyOf": [
                  {
                    "maxLength": 300,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "category": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "name": {
                "maxLength": 200,
                "type": "string"
              },
              "place_id": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "score": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "place_id",
              "name",
              "score"
            ],
            "type": "object"
          },
          "ParsedPlanItem": {
            "properties": {
              "address": {
                "anyOf": [
                  {
                    "maxLength": 300,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "amount_minor": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "city": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "currency": {
                "anyOf": [
                  {
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "day": {
                "anyOf": [
                  {
                    "maximum": 60,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "end_time": {
                "anyOf": [
                  {
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "index": {
                "minimum": 0,
                "type": "integer"
              },
              "place_name": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "quote": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              "start_time": {
                "anyOf": [
                  {
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "transport": {
                "anyOf": [
                  {
                    "enum": [
                      "walk",
                      "public_transport",
                      "car",
                      "taxi",
                      "bike",
                      "other"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "index",
              "place_name",
              "quote"
            ],
            "type": "object"
          },
          "PlaceMatch": {
            "properties": {
              "candidates": {
                "items": {
                  "$ref": "#/$defs/MatchCandidate"
                },
                "maxItems": 9,
                "type": "array"
              },
              "confidence": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "item_index": {
                "minimum": 0,
                "type": "integer"
              },
              "place_id": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "status": {
                "enum": [
                  "matched",
                  "needs_confirmation",
                  "unrecognized"
                ],
                "type": "string"
              }
            },
            "required": [
              "item_index",
              "status"
            ],
            "type": "object"
          },
          "UnreadItem": {
            "properties": {
              "quote": {
                "maxLength": 1000,
                "type": "string"
              },
              "reason": {
                "enum": [
                  "quote_not_in_text",
                  "invalid_item"
                ],
                "type": "string"
              }
            },
            "required": [
              "quote",
              "reason"
            ],
            "type": "object"
          }
        },
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/ParsedPlanItem"
            },
            "maxItems": 300,
            "type": "array"
          },
          "matches": {
            "items": {
              "$ref": "#/$defs/PlaceMatch"
            },
            "maxItems": 300,
            "type": "array"
          },
          "unread": {
            "items": {
              "$ref": "#/$defs/UnreadItem"
            },
            "maxItems": 300,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "queue": "openrouter"
    },
    "ping": {
      "input": {
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "message": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "worker_app_version": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "worker_app_version"
        ],
        "type": "object"
      },
      "queue": "default"
    },
    "write_justifications": {
      "input": {
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "locale": {
            "default": "pl",
            "enum": [
              "pl",
              "en"
            ],
            "type": "string"
          },
          "plan_id": {
            "format": "uuid",
            "type": "string"
          },
          "provider": {
            "default": "openrouter",
            "enum": [
              "openrouter",
              "local"
            ],
            "type": "string"
          }
        },
        "required": [
          "plan_id"
        ],
        "type": "object"
      },
      "output": {
        "$defs": {
          "Justification": {
            "properties": {
              "place_id": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "profile_id": {
                "anyOf": [
                  {
                    "format": "uuid",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "source": {
                "enum": [
                  "model",
                  "template"
                ],
                "type": "string"
              },
              "text": {
                "maxLength": 600,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "place_id",
              "text",
              "source"
            ],
            "type": "object"
          }
        },
        "properties": {
          "contract_version": {
            "default": 1,
            "type": "integer"
          },
          "justifications": {
            "items": {
              "$ref": "#/$defs/Justification"
            },
            "maxItems": 600,
            "type": "array"
          }
        },
        "required": [
          "justifications"
        ],
        "type": "object"
      },
      "queue": "openrouter"
    }
  }
}
