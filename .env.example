# TuttiTrip worker settings (src/tuttitrip_worker/shared/config/settings.py).
# Copy to `.env` and adjust. Variables have the TUTTITRIP_ prefix and nested
# settings use a double underscore (TUTTITRIP_<GROUP>__<FIELD>), except the
# two standard DBOS names below.
# tests/test_settings.py fails if this file and the Settings class diverge.

# Environment name: local, main, develop or a branch slug (set by deploys).
TUTTITRIP_ENVIRONMENT=local

# Application database. On the host: the restricted role `tuttitrip_worker`
# (written by the backend deploy). Locally: the backend's compose database.
TUTTITRIP_WORKER_DATABASE_URL=postgresql://tuttitrip:tuttitrip@localhost:5432/tuttitrip
# Connections kept open to it, and extra ones allowed above that.
TUTTITRIP_DB_POOL_SIZE=5
TUTTITRIP_DB_MAX_OVERFLOW=5
# DBOS system database (schema `dbos`, created by the backend with
# `dbos migrate`); empty = the database above. Standard DBOS variable name.
DBOS_SYSTEM_DATABASE_URL=
# DBOS application version, constant per environment (`<env>` on the host).
# The backend enqueues with the same value. Standard DBOS variable name.
DBOS__APPVERSION=local

# Seconds running workflows get to finish on SIGTERM.
TUTTITRIP_DBOS__SHUTDOWN_TIMEOUT_SEC=30
# DEBUG, INFO, WARNING or ERROR.
TUTTITRIP_DBOS__LOG_LEVEL=INFO
# Attempts of a database or HTTP step before its workflow fails.
TUTTITRIP_DBOS__STEP_MAX_ATTEMPTS=3
# Attempts of the embedding model call and the pause between them (seconds).
TUTTITRIP_DBOS__EMBED_MAX_ATTEMPTS=4
TUTTITRIP_DBOS__EMBED_RETRY_INTERVAL_SECONDS=2.0

# OpenRouter. Empty key = use the standard OPENROUTER_API_KEY variable.
TUTTITRIP_LLM__OPENROUTER_API_KEY=
TUTTITRIP_LLM__OPENROUTER_MODEL=google/gemini-3.8-flash
TUTTITRIP_LLM__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# JEV decision model (tuttitrip:decide-cloud) through OpenRouter.
TUTTITRIP_LLM__JEV_MODEL=typesafe/jev-1.13
# GB10 behind LiteLLM: Qwen and the decision models basal and Laya. The key is
# a secret (host only); empty = the GB10 models are skipped.
TUTTITRIP_LLM__GB10_BASE_URL=https://llm.gburek.app/v1
TUTTITRIP_LLM__GB10_API_KEY=
TUTTITRIP_LLM__GB10_AGENT_MODEL=qwen3.8-27b
TUTTITRIP_LLM__GB10_CHAT_MODEL=qwen3.8-27b-chat
TUTTITRIP_LLM__BASAL_BASE_URL=https://llm.gburek.app/basal/v1
TUTTITRIP_LLM__BASAL_MODEL=basal
TUTTITRIP_LLM__LAYA_BASE_URL=https://llm.gburek.app/laya/v1
TUTTITRIP_LLM__LAYA_MODEL=laya
# Local OpenAI-compatible chat endpoint (SGLang on dellpromaxgb10, or Ollama).
TUTTITRIP_LLM__LOCAL_BASE_URL=http://localhost:30000/v1
TUTTITRIP_LLM__LOCAL_API_KEY=local
TUTTITRIP_LLM__LOCAL_MODEL=qwen3.8-27b
# OpenAI-compatible embeddings endpoint (Ollama + `ollama pull nomic-embed-text`).
TUTTITRIP_LLM__EMBEDDING_BASE_URL=http://localhost:11434/v1
TUTTITRIP_LLM__EMBEDDING_API_KEY=ollama
TUTTITRIP_LLM__EMBEDDING_MODEL=nomic-embed-text
# Must match the vector column created by the backend migration.
TUTTITRIP_LLM__EMBEDDING_DIMENSIONS=768

# Daily reset of the demo account: shared secret of the backend's internal
# endpoint (written by the backend deploy; empty = the run warns, and fails outside local)
# and an optional API base URL (empty = tuttitrip-api[-<env>]:8000 on Docker;
# set http://localhost:8000 for a local run).
TUTTITRIP_DEMO__RESET_SECRET=
TUTTITRIP_DEMO__API_BASE_URL=
# Attempts of the reset call and the pause between them (seconds).
TUTTITRIP_DEMO__RESET_MAX_ATTEMPTS=3
TUTTITRIP_DEMO__RESET_RETRY_INTERVAL_SECONDS=60.0

# OpenStreetMap services (fetch_place_candidates). Overpass: ~1/100 of the
# per-instance quota (100 a day) shared by develop and main, which use separate
# databases and so count separately: 50 per environment. Never in parallel.
# Nominatim: at most 1 request a second.
TUTTITRIP_OSM__NOMINATIM_URL=https://nominatim.openstreetmap.org
TUTTITRIP_OSM__OVERPASS_URL=https://overpass-api.de/api/interpreter
# Names the application to both services (their policies require it).
TUTTITRIP_OSM__USER_AGENT="TuttiTrip/1.0 (+https://github.com/HackYeah-TuttiTripTeam/tuttitrip-worker)"
TUTTITRIP_OSM__REFRESH_DAYS=30
TUTTITRIP_OSM__OVERPASS_DAILY_LIMIT=50

# Pasted plan items are matched to the catalog: true = the decision model picks
# among the candidates, false = only the similarity threshold decides.
TUTTITRIP_LINTER__MATCH_WITH_MODEL=true
